/* ═══ CARD DRAW ═══ */
function PageC({ system, cnt, question, onResult, onBack }) {
  const [cards, setCards] = useState([]);
  const [rev, setRev] = useState([]);
  const [done, setDone] = useState(false);
  const started = useRef(false);
  const tmr = useRef(null);

  useEffect(() => {
    if (started.current) return;
    started.current = true;
    const drawn = system === "tarot" ? drawT(cnt) : drawL(cnt);
    setCards(drawn);
    let idx = 0;
    function next() {
      if (idx >= drawn.length) { setDone(true); return; }
      const ci = idx;
      setRev(p => [...p, ci]);
      idx++;
      tmr.current = setTimeout(next, idx === 1 ? 500 : 1200);
    }
    tmr.current = setTimeout(next, 900);
    return () => { if (tmr.current) clearTimeout(tmr.current); };
  }, []);

  function fmt() {
    const sn = system === "tarot" ? "塔羅" : "雷諾曼";
    const cs = cards.map(c => system === "tarot" ? `${c.rev ? "逆位" : "正位"}${c.name}` : c.name);
    return `【${sn}${cnt}張牌結果】\n占問：${question}\n\n牌面：${cs.join("、")}`;
  }

  // Mobile-first sizing: 3 cards fit in ~330px, 5 cards fit too
  const cw = cnt <= 3 ? 98 : 60;
  const ch = cnt <= 3 ? 152 : 96;

  return (
    <Wrap><BkBtn onClick={onBack} />
    <div style={{ padding:"76px 20px 40px", animation:"fu 0.6s ease" }}>
      <div style={{ textAlign:"center", marginBottom:28 }}>
        <h1 className="it" style={{ fontSize:24, fontWeight:300, fontStyle:"italic", letterSpacing:2 }}>
          {system === "tarot" ? "Tarocchi" : "Lenormand"}
        </h1>
        <div style={{ fontSize:11, color:"#aaa", marginTop:8, letterSpacing:2 }}>
          {rev.length < cnt ? `${rev.length} / ${cnt}` : "牌面已開"}
        </div>
      </div>

      <div style={{ display:"flex", gap:cnt<=3?10:7, justifyContent:"center", marginBottom:32, minHeight:ch+10, flexWrap:"nowrap" }}>
        {Array.from({ length: cnt }).map((_, i) => {
          const show = rev.includes(i);
          const c = cards[i];
          return (
            <div key={i} style={{ width:cw, height:ch, perspective:600, flexShrink:0 }}>
              <div style={{
                width:"100%", height:"100%", position:"relative",
                transformStyle:"preserve-3d",
                transition:"transform 0.65s cubic-bezier(0.4,0,0.2,1)",
                transform: show ? "rotateY(180deg)" : "rotateY(0deg)",
              }}>
                {/* BACK */}
                <div style={{ position:"absolute", width:"100%", height:"100%", backfaceVisibility:"hidden", WebkitBackfaceVisibility:"hidden", borderRadius:10, background:"linear-gradient(155deg,#6b8f71,#4a6b4e)", display:"flex", alignItems:"center", justifyContent:"center", boxShadow:"0 2px 8px rgba(0,0,0,0.1)" }}>
                  <div style={{ width:"68%", height:"78%", border:"1px solid rgba(255,255,255,0.15)", borderRadius:6, display:"flex", alignItems:"center", justifyContent:"center" }}>
                    <span style={{ fontSize:cnt<=3?14:10, color:"rgba(255,255,255,0.2)" }}>✦</span>
                  </div>
                </div>
                {/* FRONT */}
                <div style={{ position:"absolute", width:"100%", height:"100%", backfaceVisibility:"hidden", WebkitBackfaceVisibility:"hidden", transform:"rotateY(180deg)", borderRadius:10, background:"#fff", border:"1px solid #ddd9d2", display:"flex", flexDirection:"column", alignItems:"center", justifyContent:"center", padding:cnt<=3?10:6, boxShadow:"0 3px 14px rgba(0,0,0,0.08)" }}>
                  {c && (<>
                    {system === "tarot" && (
                      <div style={{ position:"absolute", top:cnt<=3?7:4, fontSize:cnt<=3?9:7, letterSpacing:2, color:c.rev?"#c07070":"#6b8f71", fontWeight:500 }}>
                        {c.rev ? "逆位" : "正位"}
                      </div>
                    )}
                    <div style={{ fontSize:cnt<=3?14:10, fontWeight:500, color:"#2c2c2c", letterSpacing:cnt<=3?2:1, textAlign:"center", lineHeight:1.6, transform:system==="tarot"&&c.rev?"rotate(180deg)":"none" }}>
                      {c.name}
                    </div>
                    {system === "tarot" && TAROT_MAJOR.includes(c.name) && (
                      <div style={{ position:"absolute", bottom:cnt<=3?7:4, fontSize:cnt<=3?8:6, color:"#b8956a", letterSpacing:1 }}>大秘儀</div>
                    )}
                  </>)}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {done && <div style={{ animation:"fu 0.5s ease", padding:"0 4px" }}><PBtn onClick={() => onResult(fmt())}>Risultato</PBtn></div>}
    </div></Wrap>
  );
}

/* ═══ LIU YAO ═══ */
function PageY({ question, onResult, onBack }) {
  const [yaos, setYaos] = useState([]);
  const [busy, setBusy] = useState(false);
  const [cur, setCur] = useState(0);
  const [hex, setHex] = useState(null);
  const [spin, setSpin] = useState(false);

  function doOne() {
    if (cur >= 6 || busy) return;
    setBusy(true); setSpin(true);
    setTimeout(() => {
      setSpin(false);
      const y = tossYao();
      const ny = [...yaos, y];
      setYaos(ny); setCur(p => p + 1); setBusy(false);
      if (ny.length === 6) setHex(compHex(ny));
    }, 700);
  }

  function doAll() {
    if (busy) return;
    setBusy(true);
    const all = []; let i = 0;
    function next() {
      if (i >= 6) { setBusy(false); setSpin(false); setHex(compHex(all)); return; }
      setSpin(true);
      setTimeout(() => {
        all.push(tossYao());
        setYaos([...all]); setCur(all.length);
        setSpin(false); i++;
        setTimeout(next, 250);
      }, 500);
    }
    next();
  }

  function reset() { setYaos([]); setCur(0); setHex(null); }

  function fmt() {
    const ms = hex.mv.length > 0 ? hex.mv.map(i => YN[i]).join("、") : "無";
    let t = `【六爻起卦結果】\n占問：${question}\n\n本卦：${hex.o}（第${hex.oN}卦）\n`;
    if (hex.hasM) t += `變卦：${hex.c}（第${hex.cN}卦）\n`;
    t += `動爻：${ms}\n\n各爻詳情（初爻→上爻）：\n`;
    yaos.forEach((y, i) => { t += `  ${YN[i]}：${y.c.join("·")} = ${y.v} → ${y.t}\n`; });
    return t;
  }

  return (
    <Wrap><BkBtn onClick={onBack} />
    <div style={{ padding:"76px 24px 40px", animation:"fu 0.6s ease" }}>
      <div style={{ textAlign:"center", marginBottom:28 }}>
        <h1 className="it" style={{ fontSize:24, fontWeight:300, fontStyle:"italic", letterSpacing:2 }}>Sei Linee</h1>
        <div style={{ fontSize:12, color:"#888", marginTop:6, letterSpacing:3 }}>六 爻 起 卦</div>
        <div style={{ fontSize:11, color:"#aaa", marginTop:5, letterSpacing:2 }}>
          {cur < 6 ? `第 ${cur+1} 爻 / 共 6 爻` : "卦象已成"}
        </div>
      </div>

      {cur < 6 && (
        <div style={{ textAlign:"center", marginBottom:24 }}>
          <div style={{ display:"flex", justifyContent:"center", gap:14, marginBottom:22 }}>
            {[0,1,2].map(ci => (
              <div key={ci} className={`coin${spin?" spin":""}`} style={{ animationDelay:`${ci*0.08}s` }} />
            ))}
          </div>
          <div style={{ display:"flex", gap:10 }}>
            <PBtn onClick={doOne} disabled={busy} style={{ flex:1 }}>擲 銅 錢</PBtn>
            <GBtn onClick={doAll} style={{ flex:1 }}>一 鍵 六 爻</GBtn>
          </div>
          {cur > 0 && <button onClick={reset} style={{ background:"none", border:"none", color:"#aaa", fontSize:11, marginTop:12, letterSpacing:1, fontFamily:"'Noto Serif TC',serif" }}>← 重擲</button>}
        </div>
      )}

      {yaos.length > 0 && (
        <div style={{ background:"#fff", borderRadius:12, padding:"18px 18px", marginBottom:22, boxShadow:"0 1px 8px rgba(0,0,0,0.04)", border:"1px solid #ddd9d2" }}>
          {[...yaos].reverse().map((y, ri) => {
            const i = yaos.length - 1 - ri;
            return (
              <div key={i} style={{ display:"flex", alignItems:"center", gap:8, padding:"9px 0", animation:"sd 0.3s ease", borderBottom:ri<yaos.length-1?"1px solid #eae6df":"none", flexWrap:"nowrap" }}>
                <span style={{ fontSize:11, color:"#888", width:30, textAlign:"right", flexShrink:0 }}>{YN[i]}</span>
                <div style={{ display:"flex", gap:3, alignItems:"center", flexShrink:0 }}>
                  {y.l === 1
                    ? <div style={{ width:56, height:8, background:y.m?"#b8956a":"#6b8f71", borderRadius:2.5 }} />
                    : <><div style={{ width:24, height:8, background:y.m?"#b8956a":"#6b8f71", borderRadius:2.5 }} /><div style={{ width:5 }} /><div style={{ width:24, height:8, background:y.m?"#b8956a":"#6b8f71", borderRadius:2.5 }} /></>
                  }
                </div>
                <span style={{ fontSize:10, color:"#aaa", flexShrink:0 }}>{y.c.join("·")}={y.v}</span>
                <span style={{ fontSize:10, color:y.m?"#b8956a":"#888", fontWeight:y.m?500:400, whiteSpace:"nowrap" }}>{y.t}</span>
              </div>
            );
          })}
        </div>
      )}

      {hex && (
        <div style={{ animation:"fu 0.6s ease" }}>
          <div style={{ background:"#fff", borderRadius:12, padding:24, marginBottom:22, textAlign:"center", border:"1px solid #c5d8c7", boxShadow:"0 2px 14px rgba(107,143,113,0.08)" }}>
            <div className="it" style={{ fontSize:11, color:"#aaa", letterSpacing:4, marginBottom:16, fontStyle:"italic" }}>Responso</div>
            <div style={{ fontSize:26, letterSpacing:6, color:"#2c2c2c", fontWeight:500 }}>{hex.o}</div>
            <div style={{ fontSize:12, color:"#888", marginTop:4 }}>第{hex.oN}卦</div>
            {hex.hasM && (<>
              <div style={{ width:1, height:20, background:"#ddd9d2", margin:"12px auto" }} />
              <div style={{ fontSize:10, color:"#aaa", letterSpacing:3, marginBottom:6 }}>變 卦</div>
              <div style={{ fontSize:26, letterSpacing:6, color:"#b8956a", fontWeight:500 }}>{hex.c}</div>
              <div style={{ fontSize:12, color:"#888", marginTop:4 }}>第{hex.cN}卦</div>
              <div style={{ marginTop:16, padding:"7px 16px", background:"#eaf1eb", borderRadius:6, display:"inline-block", fontSize:11, color:"#4a6b4e", letterSpacing:2 }}>
                動爻：{hex.mv.map(i => YN[i]).join("、")}
              </div>
            </>)}
          </div>
          <PBtn onClick={() => onResult(fmt())}>Risultato</PBtn>
        </div>
      )}
    </div></Wrap>
  );
}

/* ═══ RESULT ═══ */
function PageR({ result, onRestart }) {
  const [cp, setCp] = useState(false);
  function copy() { navigator.clipboard.writeText(result).then(() => { setCp(true); setTimeout(() => setCp(false), 2500); }); }
  return (
    <Wrap>
    <div style={{ padding:"76px 24px 40px", animation:"fu 0.6s ease" }}>
      <div style={{ textAlign:"center", marginBottom:28 }}>
        <h1 className="it" style={{ fontSize:24, fontWeight:300, fontStyle:"italic", letterSpacing:2 }}>Responso</h1>
        <Dv />
      </div>
      <div style={{ background:"#fff", borderRadius:12, padding:22, marginBottom:22, boxShadow:"0 1px 8px rgba(0,0,0,0.04)", border:"1px solid #ddd9d2", whiteSpace:"pre-wrap", fontSize:13, lineHeight:2, color:"#555" }}>{result}</div>
      <div style={{ display:"flex", gap:10 }}>
        <PBtn onClick={copy} style={{ flex:1 }}>{cp ? "Copiato ✓" : "Copia"}</PBtn>
        <GBtn onClick={onRestart} style={{ flex:1 }}>Di Nuovo</GBtn>
      </div>
    </div></Wrap>
  );
}

/* ═══ APP ═══ */
export default function App() {
  const [pg, setPg] = useState("q");
  const [q, setQ] = useState("");
  const [sys, setSys] = useState(null);
  const [cnt, setCnt] = useState(3);
  const [res, setRes] = useState("");
  return (<>
    {pg === "q" && <PageQ onNext={v => { setQ(v); setPg("s"); }} />}
    {pg === "s" && <PageS question={q} onNext={(s, c) => { setSys(s); setCnt(c); setPg("d"); }} onBack={() => setPg("q")} />}
    {pg === "d" && sys === "liuyao" && <PageY question={q} onResult={r => { setRes(r); setPg("r"); }} onBack={() => setPg("s")} />}
    {pg === "d" && sys !== "liuyao" && <PageC system={sys} cnt={cnt} question={q} onResult={r => { setRes(r); setPg("r"); }} onBack={() => setPg("s")} />}
    {pg === "r" && <PageR result={res} onRestart={() => { setPg("q"); setQ(""); setSys(null); setRes(""); }} />}
  </>);
}

function suggest(q) {
  const lk = ["該不該","要不要","是不是","會不會","還是","選","可不可以","有沒有","能不能","好不好","對不對","值不值"];
  const yk = ["會怎樣","怎麼樣","最後","結果","成不成","發展","走向","未來會","能不能成","後來","結局","下場"];
  if (lk.some(k => q.includes(k))) return "lenormand";
  if (yk.some(k => q.includes(k))) return "liuyao";
  return "tarot";
}

function shuf(a) { const b = [...a]; for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; } return b; }
function drawT(n) { return shuf(ALL_TAROT).slice(0, n).map(c => ({ name: c, rev: Math.random() < 0.5 })); }
function drawL(n) { return shuf(LENORMAND).slice(0, n).map(c => ({ name: c })); }

function tossYao() {
  const c = [Math.random() < 0.5 ? "正" : "反", Math.random() < 0.5 ? "正" : "反", Math.random() < 0.5 ? "正" : "反"];
  const h = c.filter(x => x === "正").length;
  if (h === 3) return { c, v: 9, t: "老陽（動）", l: 1, m: true };
  if (h === 2) return { c, v: 8, t: "少陰", l: 0, m: false };
  if (h === 1) return { c, v: 7, t: "少陽", l: 1, m: false };
  return { c, v: 6, t: "老陰（動）", l: 0, m: true };
}

function getTri(l) { for (const [n, p] of Object.entries(BAGUA_LINES)) if (p[0] === l[0] && p[1] === l[1] && p[2] === l[2]) return n; return ""; }

function compHex(yaos) {
  const ls = yaos.map(y => y.l);
  const ch = yaos.map(y => y.v === 9 ? 0 : y.v === 6 ? 1 : y.l);
  const lo = getTri(ls.slice(0, 3)), up = getTri(ls.slice(3, 6));
  const lc = getTri(ch.slice(0, 3)), uc = getTri(ch.slice(3, 6));
  const on = HEX_T[up + lo] || "?", cn = HEX_T[uc + lc] || "?";
  const mv = yaos.map((y, i) => y.m ? i : -1).filter(i => i >= 0);
  return { o: on, oN: HEX_N[on] || 0, c: cn, cN: HEX_N[cn] || 0, mv, hasM: mv.length > 0 };
}

